	bAbort : BOOL; // panic/home: TRUE on disarm/abort/release_all
	bChainRunning : BOOL; // status read by twincat_list_active_chains
	nActiveChain : INT;
	nCurrentStep : INT;
	bFault : BOOL;
END_VAR
